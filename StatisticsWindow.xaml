<Window x:Class="WarehousePro.Wpf.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgMain}"
        WindowStyle="None"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="KpiCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="titleBar" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="titleText" Text="Статистика" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <TextBlock x:Name="subtitleText" Margin="14,8,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Width="120" Height="34" Margin="0,0,8,0" Content="Обновить" Style="{StaticResource PrimaryButtonStyle}" Click="RefreshButton_Click"/>
                <Button x:Name="MinimizeButton" Style="{StaticResource CloseButtonStyle}" Content="–" Click="MinimizeButton_Click" ToolTip="Свернуть"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CloseButtonStyle}" Content="☐" Click="MaximizeButton_Click" ToolTip="На весь экран"/>
                <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}" Content="✕" Click="CloseButton_Click" ToolTip="Закрыть"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="kpiProductsLabel" Style="{StaticResource KpiLabelStyle}" Text="Товаров"/>
                    <TextBlock x:Name="kpiProductsValue" Style="{StaticResource KpiValueStyle}" Text="0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="kpiStockLabel" Style="{StaticResource KpiLabelStyle}" Text="На складе"/>
                    <TextBlock x:Name="kpiStockValue" Style="{StaticResource KpiValueStyle}" Text="0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="kpiLowStockLabel" Style="{StaticResource KpiLabelStyle}" Text="Ниже минимума"/>
                    <TextBlock x:Name="kpiLowStockValue" Style="{StaticResource KpiValueStyle}" Text="0" Foreground="{DynamicResource AccentGold}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="kpiOperationsLabel" Style="{StaticResource KpiLabelStyle}" Text="Операций"/>
                    <TextBlock x:Name="kpiOperationsValue" Style="{StaticResource KpiValueStyle}" Text="0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="kpiIncomingLabel" Style="{StaticResource KpiLabelStyle}" Text="Приход"/>
                    <TextBlock x:Name="kpiIncomingValue" Style="{StaticResource KpiValueStyle}" Text="0" Foreground="{DynamicResource AccentGreen}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="5" Style="{StaticResource KpiCardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock x:Name="kpiExpenseLabel" Style="{StaticResource KpiLabelStyle}" Text="Расход"/>
                    <TextBlock x:Name="kpiExpenseValue" Style="{StaticResource KpiValueStyle}" Text="0" Foreground="{DynamicResource AccentRed}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="lowStockTitle" Text="Товары с минимальным остатком" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <DataGrid x:Name="dgLowStock" Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="colLowName" Header="Товар" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn x:Name="colLowQuantity" Header="Остаток" Binding="{Binding Quantity}" Width="90"/>
                            <DataGridTextColumn x:Name="colLowMinimum" Header="Минимум" Binding="{Binding MinimumStock}" Width="90"/>
                            <DataGridTextColumn x:Name="colLowNeed" Header="Заказать" Binding="{Binding NeedToOrder}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="topProductsTitle" Text="Топ товаров по движению" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <DataGrid x:Name="dgTopProducts" Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="colTopName" Header="Товар" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn x:Name="colTopStock" Header="Остаток" Binding="{Binding Stock}" Width="80"/>
                            <DataGridTextColumn x:Name="colTopIncoming" Header="Приход" Binding="{Binding Incoming}" Width="80"/>
                            <DataGridTextColumn x:Name="colTopExpense" Header="Расход" Binding="{Binding Expense}" Width="80"/>
                            <DataGridTextColumn x:Name="colTopNet" Header="Сальдо" Binding="{Binding NetMovement}" Width="80"/>
                            <DataGridTextColumn x:Name="colTopOps" Header="Операций" Binding="{Binding OperationsCount}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="monthlyTitle" Text="Движение по месяцам" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <DataGrid x:Name="dgMonthly" Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="colMonthPeriod" Header="Период" Binding="{Binding Period}" Width="*"/>
                            <DataGridTextColumn x:Name="colMonthIncoming" Header="Приход" Binding="{Binding Incoming}" Width="90"/>
                            <DataGridTextColumn x:Name="colMonthExpense" Header="Расход" Binding="{Binding Expense}" Width="90"/>
                            <DataGridTextColumn x:Name="colMonthAdjustment" Header="Корр." Binding="{Binding Adjustment}" Width="80"/>
                            <DataGridTextColumn x:Name="colMonthNet" Header="Сальдо" Binding="{Binding NetMovement}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
