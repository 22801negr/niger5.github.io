<Window x:Class="WarehousePro.Wpf.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История операций"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgMain}"
        WindowStyle="None"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock x:Name="titleText" Text="История операций" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="MinimizeButton" Style="{StaticResource CloseButtonStyle}" Content="–" Click="MinimizeButton_Click" ToolTip="Свернуть"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CloseButtonStyle}" Content="☐" Click="MaximizeButton_Click" ToolTip="На весь экран"/>
                <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}" Content="✕" Click="CloseButton_Click" ToolTip="Закрыть"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Height="42" FontSize="15" Style="{StaticResource InputStyle}" TextChanged="TxtSearch_TextChanged"/>
                <Button x:Name="BtnSearch" Grid.Column="1" Width="100" Height="42" Margin="12,0,0,0" Content="Поиск" Click="BtnSearch_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,18,0,0" Padding="10" CornerRadius="18" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
            <DataGrid x:Name="dgHistory" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="colProduct" Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn x:Name="colType" Header="Тип" Binding="{Binding TypeDisplay}" Width="180"/>
                    <DataGridTextColumn x:Name="colQuantity" Header="Количество" Binding="{Binding Quantity}" Width="110"/>
                    <DataGridTextColumn x:Name="colDate" Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                    <DataGridTextColumn x:Name="colOrder" Header="Номер заказа" Binding="{Binding OrderNumber}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
