<Window x:Class="WarehousePro.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="460"
        Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgMain}"
        WindowStyle="None"
        ResizeMode="CanResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock x:Name="TextSettings" Text="Настройки" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="MinimizeButton" Style="{StaticResource CloseButtonStyle}" Content="–" Click="MinimizeButton_Click" ToolTip="Свернуть"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CloseButtonStyle}" Content="☐" Click="MaximizeButton_Click" ToolTip="На весь экран"/>
                <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}" Content="✕" Click="CloseButton_Click" ToolTip="Закрыть"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,10,14,10" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TextTheme" Text="Фон" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                <RadioButton x:Name="rbDarkTheme" Content="Тёмный" GroupName="ThemeGroup"/>
                <RadioButton x:Name="rbLightTheme" Content="Светлый" GroupName="ThemeGroup"/>
                <RadioButton x:Name="rbBlueTheme" Content="Синий" GroupName="ThemeGroup"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14,10,14,10" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock x:Name="TextLanguage" Text="Язык" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                <RadioButton x:Name="rbRussian" Content="Русский" GroupName="LanguageGroup"/>
                <RadioButton x:Name="rbEnglish" Content="English" GroupName="LanguageGroup"/>
            </StackPanel>
        </Border>

        <Button x:Name="SaveButton" Grid.Row="4" Height="44" Content="Сохранить" Click="BtnSave_Click" Style="{StaticResource PrimaryButtonStyle}"/>
    </Grid>
</Window>
